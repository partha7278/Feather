# feather — process settings. Copy to .env and adjust, or skip it entirely:
# every value here has a working default.
#
# Credentials do NOT belong in this file any more. MongoDB accounts, S3, Oracle
# and Google Drive destinations, retention configs and the administrator login
# are all stored in feather's database and managed from the control panel.

FEATHER_ENV=production
LOG_LEVEL=info
LOG_JSON=true

# --- Where feather keeps its own data ----------------------------------------
# One SQLite file holds everything: the admin login, the accounts, the
# retention configs, and the catalogue of every archive ever written.
# Back this directory up.
FEATHER_DATA_DIR=/var/lib/feather
# Defaults derived from FEATHER_DATA_DIR; override only if you need to.
# FEATHER_DB=/var/lib/feather/feather.db
# FEATHER_SPOOL_DIR=/var/lib/feather/spool

# --- Encryption ---------------------------------------------------------------
# Connection strings and cloud secrets are encrypted with a master key before
# being written to the database. Supply it here, or leave this blank and feather
# will generate one at FEATHER_MASTER_KEY_FILE on first start (mode 0600).
#
# Generate one with: feather keygen
#
# Keep the key with your backups. Without it, a copy of the database is unusable.
# FEATHER_MASTER_KEY=
# FEATHER_MASTER_KEY_FILE=/var/lib/feather/master.key

# --- Control panel ------------------------------------------------------------
# Bound to localhost by default; put a reverse proxy in front of it for TLS.
# Use 0.0.0.0:8477 only if the host is not reachable from the internet.
FEATHER_HTTP_ADDR=127.0.0.1:8477
# The externally visible URL, if you are behind a proxy. Used in startup logs,
# and to build the redirect URI Google sends a Drive authorisation back to.
# FEATHER_BASE_URL=https://feather.internal.example.com

# --- Scheduling ---------------------------------------------------------------
# How many retention jobs may archive at the same time. Also editable in the
# control panel under Settings.
FEATHER_MAX_CONCURRENT_JOBS=2
