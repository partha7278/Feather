# Environment for the local verification rig (testdata/docker-compose.yml).
FEATHER_ENV=local
LOG_LEVEL=info
LOG_JSON=false

FEATHER_DATA_DIR=./testdata/rig-data
FEATHER_SPOOL_DIR=./testdata/rig-data/spool
FEATHER_HTTP_ADDR=127.0.0.1:8479
FEATHER_MAX_CONCURRENT_JOBS=2

MONGO_URI=mongodb://127.0.0.1:27018
MONGO_APP_NAME=feather-rig

FEATHER_DESTINATIONS=s3-primary,s3-backup,oci-cold

# Two "S3 accounts" — same MinIO, different buckets.
DEST_S3_PRIMARY_PROVIDER=s3
DEST_S3_PRIMARY_REGION=us-east-1
DEST_S3_PRIMARY_BUCKET=feather-primary
DEST_S3_PRIMARY_ENDPOINT=http://127.0.0.1:9000
DEST_S3_PRIMARY_ACCESS_KEY_ID=featherkey
DEST_S3_PRIMARY_SECRET_ACCESS_KEY=feathersecret
DEST_S3_PRIMARY_FORCE_PATH_STYLE=true

DEST_S3_BACKUP_PROVIDER=s3
DEST_S3_BACKUP_REGION=us-east-1
DEST_S3_BACKUP_BUCKET=feather-backup
DEST_S3_BACKUP_ENDPOINT=http://127.0.0.1:9000
DEST_S3_BACKUP_ACCESS_KEY_ID=featherkey
DEST_S3_BACKUP_SECRET_ACCESS_KEY=feathersecret
DEST_S3_BACKUP_FORCE_PATH_STYLE=true
DEST_S3_BACKUP_PREFIX=dr

# Stands in for Oracle Object Storage: exercises the compat path (path-style
# addressing, checksums only where required).
DEST_OCI_COLD_PROVIDER=oci
DEST_OCI_COLD_REGION=us-east-1
DEST_OCI_COLD_BUCKET=feather-cold
DEST_OCI_COLD_ENDPOINT=http://127.0.0.1:9000
DEST_OCI_COLD_ACCESS_KEY_ID=featherkey
DEST_OCI_COLD_SECRET_ACCESS_KEY=feathersecret
